# =============================================================================
# Configuration locale
# Copier ce fichier vers .env puis lancer : make init
# Le fichier .env ne doit JAMAIS être commité.
# =============================================================================

# --- Général ---------------------------------------------------------------
# Nom de domaine sans extension (localhost ou supername3000).
DOMAIN_NAME=localhost
# Extension avec le point initial (.fr), ou vide pour un domaine local.
TLD=
# Nom de domaine complet, calculé depuis DOMAIN_NAME et TLD.
# Sert aussi de nom d'hôte à la machine et d'invite shell (admin@domaine).
DOMAIN=${DOMAIN_NAME}${TLD}
TZ=Europe/Paris
ACME_EMAIL=admin@${DOMAIN}

# Réseaux Docker partagés (créés par make init)
PROXY_NETWORK=${DOMAIN_NAME}_proxy
DB_ADMIN_NETWORK=${DOMAIN_NAME}_db_admin
MINECRAFT_NETWORK=${DOMAIN_NAME}_minecraft_internal

# Dossier d'installation de mailcow (stack officielle séparée)
MAILCOW_DIR=/opt/mailcow-dockerized

# --- Traefik ---------------------------------------------------------------
TRAEFIK_DASHBOARD_HOST=traefik.${DOMAIN}
TRAEFIK_DASHBOARD_USER=admin
TRAEFIK_DASHBOARD_PASSWORD=CHANGE_ME
TRAEFIK_LOG_LEVEL=INFO
TRAEFIK_ACME_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory

# --- Site PHP (remplace phpdoc) -------------------------------------------
PHP_DB_ROOT_PASSWORD=CHANGE_ME
PHP_DB_NAME=php_site
PHP_DB_USER=php_site
PHP_DB_PASSWORD=CHANGE_ME
# Dépôt du site cloné dans stacks/web/php-site/src par make php-site-src.
PHP_SITE_REPO_URL=https://github.com/Altherneum/website.git
PHP_SITE_REPO_REF=main
WEBSITE_ADMIN_USERNAME=${DOMAIN_NAME}
WEBSITE_ADMIN_PASSWORD=CHANGE_ME
# Optionnel : identifiant Discord de l'admin du site.
WEBSITE_ADMIN_DISCORD_USER_ID=
# Optionnel : OAuth Discord du site. Laisser vide pour désactiver.
WEBSITE_DISCORD_CLIENT_ID=
WEBSITE_DISCORD_CLIENT_SECRET=
# Vide = https://php.${DOMAIN}/discord/callback (calculé par make php-site-src).
WEBSITE_DISCORD_REDIRECT_URI=
# true = initialise automatiquement les tables du site au premier démarrage.
WEBSITE_AUTO_INIT=true
# true = donne le dépôt src à l'utilisateur apache pour que /api/deploy
# puisse exécuter git pull. false = garde les fichiers de l'hôte intacts.
WEBSITE_GIT_DEPLOY=true

# --- Azuriom ---------------------------------------------------------------
AZURIOM_VERSION=1.2.13
AZURIOM_SHOP_VERSION=1.2.26
AZURIOM_PRISM_VERSION=1.1.0
AZURIOM_DB_ROOT_PASSWORD=CHANGE_ME
AZURIOM_DB_NAME=azuriom
AZURIOM_DB_USER=azuriom
AZURIOM_DB_PASSWORD=CHANGE_ME
AZURIOM_APP_KEY=CHANGE_ME
# mc-online : connexion Microsoft (VELOCITY_ONLINE_MODE=true).
# mc-offline : comptes locaux Azuriom (UUID hors-ligne), pour un serveur
# non premium : passer aussi VELOCITY_ONLINE_MODE=false.
AZURIOM_GAME=mc-online
# UUID Minecraft du compte admin, 32 caractères hexadécimaux sans tirets.
# Requis au premier démarrage en mc-online. Exemple :
#   curl -s https://api.mojang.com/users/profiles/minecraft/<pseudo>
AZURIOM_ADMIN_GAME_ID=
AZURIOM_ADMIN_NAME=admin
AZURIOM_ADMIN_EMAIL=admin@${DOMAIN}
AZURIOM_ADMIN_PASSWORD=CHANGE_ME
# Optionnel : application Microsoft Entra ID dédiée.
# Laisser vide utilise le relais OAuth officiel d'Azuriom.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Resource pack commun à Azuriom et aux serveurs Paper. Paper le télécharge pour calculer son SHA-1 ; Azuriom le copie dans son volume s'il est démarré.
AZURIOM_RESOURCE_PACK_URL=https://github.com/Altherneum/resourcePack/releases/latest/download/resourcePack.zip

# Mail : laisser AZURIOM_MAIL_MAILER=log tant que mailcow n'est pas prêt.
# Une fois mailcow configuré : AZURIOM_MAIL_MAILER=smtp
AZURIOM_MAIL_MAILER=log
AZURIOM_MAIL_HOST=mail.${DOMAIN}
AZURIOM_MAIL_PORT=587
AZURIOM_MAIL_USERNAME=noreply@${DOMAIN}
AZURIOM_MAIL_PASSWORD=CHANGE_ME
AZURIOM_MAIL_ENCRYPTION=tls
AZURIOM_MAIL_FROM_ADDRESS=noreply@${DOMAIN}

# --- Forgejo ---------------------------------------------------------------
FORGEJO_VERSION=16.0.6
FORGEJO_DB_ROOT_PASSWORD=CHANGE_ME
FORGEJO_DB_NAME=forgejo
FORGEJO_DB_USER=forgejo
FORGEJO_DB_PASSWORD=CHANGE_ME
FORGEJO_SECRET_KEY=CHANGE_ME
FORGEJO_INTERNAL_TOKEN=CHANGE_ME
FORGEJO_LFS_JWT_SECRET=CHANGE_ME
FORGEJO_OAUTH2_JWT_SECRET=CHANGE_ME
# Forgejo réserve certains noms (admin, api, user, …) : garder un nom simple.
FORGEJO_ADMIN_NAME=${DOMAIN_NAME}
FORGEJO_ADMIN_EMAIL=admin@${DOMAIN}
FORGEJO_ADMIN_PASSWORD=CHANGE_ME
# Protection HTTP Basic par Traefik pour Forgejo.
FORGEJO_HTTP_USER=forgejo
FORGEJO_HTTP_PASSWORD=CHANGE_ME
FORGEJO_MAIL_ENABLED=false
FORGEJO_MAIL_HOST=mail.${DOMAIN}
FORGEJO_MAIL_PORT=587
FORGEJO_MAIL_USER=git@${DOMAIN}
FORGEJO_MAIL_PASSWORD=CHANGE_ME
FORGEJO_MAIL_FROM=git@${DOMAIN}

# Organisation GitHub importée dans Forgejo et clonée par code-server.
# Laisser vide pour désactiver l'import automatique.
# Exemple : https://github.com/altherneum
FORGEJO_GITHUB_ORG_URL=https://github.com/altherneum
# Jeton GitHub (scope « repo ») : nécessaire pour les dépôts privés, l'import
# des issues/PR/releases et le miroir push Forgejo -> GitHub.
# Sans jeton, seul le code Git public est importé (API GitHub : 60 req/h).
GITHUB_TOKEN=
# Identifiant GitHub associé au jeton. « x-access-token » fonctionne avec un
# personal access token classique.
GITHUB_USER=x-access-token
# Propriétaire Forgejo des dépôts importés (défaut : compte admin Forgejo).
FORGEJO_OWNER=${FORGEJO_ADMIN_NAME}
# Jeton API Forgejo optionnel pour les scripts. Laisser vide pour utiliser
# FORGEJO_ADMIN_NAME / FORGEJO_ADMIN_PASSWORD.
FORGEJO_API_TOKEN=
# auto = import complet si GITHUB_TOKEN est défini, code Git seul sinon.
# true = import complet même sans jeton (très lent : quota GitHub 60 req/h).
# false = code Git uniquement (rapide, sans issues/PR/releases).
FORGEJO_GITHUB_MIGRATE_METADATA=auto
# Délai max d'attente de l'appel de migration (secondes, 0 = illimité).
# Au-delà, Forgejo poursuit la migration en arrière-plan.
FORGEJO_GITHUB_MIGRATE_TIMEOUT=1800
# true = configure un miroir push Forgejo -> GitHub (nécessite GITHUB_TOKEN).
FORGEJO_GITHUB_PUSH_MIRROR=true
# Intervalle de synchronisation du miroir push (8h, 24h, 0 pour manuel).
FORGEJO_GITHUB_MIRROR_INTERVAL=8h
# true = synchronise le miroir push à chaque push reçu par Forgejo.
FORGEJO_GITHUB_MIRROR_SYNC_ON_COMMIT=true

# --- Forgejo Actions (CI/CD) ----------------------------------------------
# GID du socket Docker, utilisé par le runner pour lancer les conteneurs de jobs.
# Renseigné automatiquement par make init.
DOCKER_GID=
FORGEJO_RUNNER_VERSION=13.2.1
FORGEJO_RUNNER_NAME=forgejo-runner
FORGEJO_RUNNER_CAPACITY=2
FORGEJO_RUNNER_TIMEOUT=3h
# automount = socket Docker disponible dans les jobs (docker build, etc.).
# "-" = pas d'accès Docker depuis les jobs.
FORGEJO_RUNNER_DOCKER_HOST=automount
FORGEJO_RUNNER_LOG_LEVEL=info
# Labels exposés aux workflows (runs-on), séparés par des virgules.
FORGEJO_RUNNER_LABELS=ubuntu-latest:docker://ghcr.io/catthehacker/ubuntu:act-latest,ubuntu-24.04:docker://ghcr.io/catthehacker/ubuntu:act-24.04,ubuntu-22.04:docker://ghcr.io/catthehacker/ubuntu:act-22.04,ubuntu-20.04:docker://ghcr.io/catthehacker/ubuntu:act-20.04,docker:docker://ghcr.io/catthehacker/ubuntu:act-latest,self-hosted:docker://ghcr.io/catthehacker/ubuntu:act-latest
# URL de base des actions (https://data.forgejo.org ou https://github.com).
FORGEJO_ACTIONS_DEFAULT_URL=https://data.forgejo.org

# --- code-server -----------------------------------------------------------
CODE_SERVER_PASSWORD=CHANGE_ME
CODE_SERVER_VERSION=4.144.0
# --- Traefik HTTP Basic Auth pour code-server ---
CODE_SERVER_HTTP_USER=code-server
CODE_SERVER_HTTP_PASSWORD=CHANGE_ME
# Thème sombre par défaut (extension intégrée vscode.theme-defaults).
# Appliqué uniquement si aucun thème n'est déjà choisi dans l'interface.
CODE_SERVER_THEME="Default High Contrast"
# Clone les dépôts de CODE_SERVER_GITHUB_ORG_URL dans le workspace au démarrage.
CODE_SERVER_CLONE_GITHUB_ORG=true
# Organisation GitHub importée par code-server.
# Exemple : https://github.com/altherneum
CODE_SERVER_GITHUB_ORG_URL=https://github.com/altherneum
# URL interne de Forgejo (réseau Docker) ajoutée comme remote « forgejo ».
FORGEJO_INTERNAL_URL=http://forgejo:3000
# Profil Git global dans le conteneur (commits et outils Git de code-server).
# Laisser vide pour ne pas le configurer automatiquement.
GIT_USER_NAME=${DOMAIN_NAME}
GIT_USER_EMAIL=admin@${DOMAIN}

# --- KeeWeb ----------------------------------------------------------------
KEEWEB_UI_USER=keeweb
KEEWEB_UI_PASSWORD=CHANGE_ME
KEEWEB_WEBDAV_USER=webdav
KEEWEB_WEBDAV_PASSWORD=CHANGE_ME

# --- Nextcloud -------------------------------------------------------------
# Version majeure de l'image officielle (https://github.com/nextcloud/docker).
NEXTCLOUD_VERSION=35
NEXTCLOUD_REDIS_VERSION=8-alpine
NEXTCLOUD_DB_ROOT_PASSWORD=CHANGE_ME
NEXTCLOUD_DB_NAME=nextcloud
NEXTCLOUD_DB_USER=nextcloud
NEXTCLOUD_DB_PASSWORD=CHANGE_ME
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=CHANGE_ME
NEXTCLOUD_ADMIN_EMAIL=admin@${DOMAIN}
NEXTCLOUD_REDIS_PASSWORD=CHANGE_ME
# Proxies de confiance pour Traefik (réseaux Docker privés).
NEXTCLOUD_TRUSTED_PROXIES=172.16.0.0/12 10.0.0.0/8 192.168.0.0/16
# Limites PHP/Apache pour les gros fichiers (10G, taille du corps illimitée).
NEXTCLOUD_PHP_MEMORY_LIMIT=512M
NEXTCLOUD_PHP_UPLOAD_LIMIT=10G
NEXTCLOUD_APACHE_BODY_LIMIT=0
# E-mail optionnel : laisser NEXTCLOUD_MAIL_HOST vide pour désactiver l'envoi.
# Pour l'activer, renseigner l'hôte SMTP de mailcow, puis créer la boîte
# NEXTCLOUD_MAIL_USERNAME avec le mot de passe NEXTCLOUD_MAIL_PASSWORD.
NEXTCLOUD_MAIL_HOST=
NEXTCLOUD_MAIL_PORT=587
NEXTCLOUD_MAIL_SECURE=tls
NEXTCLOUD_MAIL_USERNAME=cloud@${DOMAIN}
NEXTCLOUD_MAIL_PASSWORD=CHANGE_ME
NEXTCLOUD_MAIL_FROM_ADDRESS=cloud@${DOMAIN}
NEXTCLOUD_MAIL_DOMAIN=${DOMAIN}

# --- Dockhand --------------------------------------------------------------
# Interface d'administration Docker (https://github.com/Finsys/dockhand).
# Les tags Docker Hub ont le préfixe « v ».
DOCKHAND_VERSION=v1.0.57
# Utilisateur et groupe internes du conteneur (UID/GID sans privilèges).
DOCKHAND_PUID=1001
DOCKHAND_PGID=1001
# Clé de chiffrement des identifiants stockés par Dockhand (base64, 32 octets).
# Ne pas la modifier après le premier démarrage.
DOCKHAND_ENCRYPTION_KEY=CHANGE_ME
# Protection HTTP Basic par Traefik (l'interface donne accès au socket Docker).
DOCKHAND_HTTP_USER=dockhand
DOCKHAND_HTTP_PASSWORD=CHANGE_ME
# Crée automatiquement l'environnement Docker local (/var/run/docker.sock)
# au premier démarrage. Idempotent : ne modifie pas une configuration existante.
DOCKHAND_AUTO_LOCAL_ENV=true

# --- Uptime Kuma -----------------------------------------------------------
# Supervision des services et des conteneurs (https://github.com/louislam/uptime-kuma).
UPTIME_KUMA_VERSION=2.5.10
# Proxy Docker en lecture seule pour les moniteurs de conteneurs.
UPTIME_KUMA_DOCKER_PROXY_VERSION=v0.5.0
# Base SQLite, incluse dans le volume uptime-kuma-data.
UPTIME_KUMA_DB_TYPE=sqlite
# Compte administrateur créé automatiquement par make up / up-service.
# Modifier ces valeurs ici ne change pas un compte déjà existant.
UPTIME_KUMA_ADMIN_USER=admin
UPTIME_KUMA_ADMIN_PASSWORD=CHANGE_ME
# Synchronise les conteneurs Docker en moniteurs « Docker Container ».
# La synchronisation est lancée par make up et make up-service (si Uptime Kuma tourne).
UPTIME_KUMA_DOCKER_SYNC=true
# Hôte Docker ajouté automatiquement dans Uptime Kuma.
UPTIME_KUMA_DOCKER_HOST_NAME=Local
# URL interne du proxy Docker. Doit correspondre au service du compose.
UPTIME_KUMA_DOCKER_HOST_URL=http://uptime-kuma-docker-proxy:2375
# Conteneurs à ne pas surveiller automatiquement (noms séparés par des virgules).
# Exemple : UPTIME_KUMA_DOCKER_EXCLUDE=uptime-kuma,mon-conteneur
UPTIME_KUMA_DOCKER_EXCLUDE=

# Notification Discord préconfigurée par la synchronisation.
# Renseigner uniquement l'URL du webhook ; laisser vide pour ne pas la créer.
UPTIME_KUMA_DISCORD_ENABLED=true
UPTIME_KUMA_DISCORD_WEBHOOK_URL=
UPTIME_KUMA_DISCORD_BOT_NAME=Uptime
UPTIME_KUMA_DISCORD_PREFIX=<@&DISCORD_ROLE_ID_TO_PING>
UPTIME_KUMA_DISCORD_NOTIFICATION_NAME=Discord
# Active la notification par défaut pour les nouveaux moniteurs.
UPTIME_KUMA_DISCORD_DEFAULT=true
# Applique aussi la notification aux moniteurs déjà existants.
UPTIME_KUMA_DISCORD_APPLY_EXISTING=true

# --- phpMyAdmin ------------------------------------------------------------
# Hôtes MariaDB accessibles via le réseau db-admin.
PMA_HOSTS=db-azuriom,db-php,db-nextcloud
PMA_BLOWFISH_SECRET=CHANGE_ME
# Utilisée par Traefik pour phpMyAdmin.
PMA_ADMIN_USER=admin
PMA_ADMIN_PASSWORD=CHANGE_ME

# --- Minecraft Plugins -----------------------------------------------------
PAPER_VERSION=1.21.11
PAPER_BUILD=132
PLUGIN_VERSION=70
VIAVERSION_VERSION=5.12.1
VIABACKWARDS_VERSION=5.12.1
WORLDEDIT_VERSION=7.4.6
WORLDEDIT_OPAQUE=YFnqiUlL
GEYSER_VERSION=2.12.1
FLOODGATE_VERSION=2.2.5

# --- Minecraft -------------------------------------------------------------
MINECRAFT_PORT=25565
MINECRAFT_LEVEL_NAME=Spawn
MINECRAFT_MAX_PLAYERS=20
MINECRAFT_MEMORY_HUB=1G
MINECRAFT_MEMORY_SURVIE=1G
MINECRAFT_MEMORY_CREATIF=1G
MINECRAFT_MEMORY_ANARCHIE=1G
MINECRAFT_MEMORY_RPG=1G
MINECRAFT_MEMORY_SKYBLOCK=1G
MINECRAFT_MEMORY_OPPRISON=1G
MINECRAFT_MEMORY_TEST=512M
VELOCITY_MEMORY=512M
VELOCITY_SECRET=CHANGE_ME
# true = authentification Mojang (premium, à garder avec AZURIOM_GAME=mc-online).
# false = comptes locaux/hors-ligne (à garder avec AZURIOM_GAME=mc-offline).
VELOCITY_ONLINE_MODE=true
VELOCITY_MOTD="<#09add3>${DOMAIN}"
MINECRAFT_RCON_PASSWORD=CHANGE_ME
# Port RCON utilisé par les serveurs Paper et par Azuriom. Il reste interne au
# réseau Docker : install.sh ne l'ouvre pas dans UFW.
MINECRAFT_RCON_PORT=25575
# Un jeton par serveur Minecraft : chaque serveur a son propre bot Discord.
# Laisser vide pour désactiver le bot d'un serveur.
# https://discord.com/developers/applications
MINECRAFT_DISCORD_TOKEN_HUB=
MINECRAFT_DISCORD_TOKEN_SURVIE=
MINECRAFT_DISCORD_TOKEN_CREATIF=
MINECRAFT_DISCORD_TOKEN_ANARCHIE=
MINECRAFT_DISCORD_TOKEN_RPG=
MINECRAFT_DISCORD_TOKEN_SKYBLOCK=
MINECRAFT_DISCORD_TOKEN_OPPRISON=
MINECRAFT_DISCORD_TOKEN_TEST=

# --- Bot Discord -----------------------------------------------------------
# Obligatoire : origine du jar du bot Discord (release GitHub, miroir, URL HTTP accessible au build)
BOT_URL="https://github.com/Altherneum/bot-rewrite/releases/latest/download/bot-rewrite-1.0-fat.jar"
DISCORD_BOT_NAME=${DOMAIN_NAME}
# À renseigner manuellement : https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# --- Webhooks SSH (Discord) ------------------------------------------------
# URL du webhook pour chaque connexion SSH non interactive.
# Laisser vide pour désactiver.
DISCORD_WEBHOOK_SSH=
# URL du webhook pour les sessions interactives.
# Vide = utilise DISCORD_WEBHOOK_SSH.
DISCORD_WEBHOOK_SESSION=

# --- Sécurisation de l'hôte (étape finale de install.sh) --------------------
# Compte admin créé par install.sh. root est interdit en SSH : connectez-vous
# en admin, puis utilisez « su - » (ou sudo -i) pour passer root.
HARDEN_ADMIN_USER=admin
# Mot de passe sudo du compte admin. Laisser vide pour en générer un.
HARDEN_ADMIN_PASSWORD=CHANGE_ME
# Fichier de clé publique à autoriser si vous ne passez pas --pubkey-file.
# Exemple : /tmp/id_ed25519.pub
HARDEN_SSH_PUBKEY_FILE=
# Port SSH appliqué par install.sh. 22 par défaut : changez cette valeur pour
# écrire un autre port dans sshd, UFW et fail2ban.
HARDEN_SSH_PORT=22
# Jail fail2ban SSH (conteneur fail2ban).
HARDEN_FAIL2BAN_MAXRETRY=3
HARDEN_FAIL2BAN_BANTIME=1h
HARDEN_FAIL2BAN_FINDTIME=10m
# Journal SSH lu par le conteneur fail2ban. Vide = détection automatique.
# Debian/Ubuntu : /var/log/auth.log ; Alpine : /var/log/messages.
FAIL2BAN_SSH_LOG=
# Ports TCP/UDP supplémentaires à ouvrir dans UFW (séparés par des virgules).
HARDEN_EXTRA_TCP=
HARDEN_EXTRA_UDP=
