# =============================================================================
# Override mailcow : placé dans $MAILCOW_DIR/docker-compose.override.yml
# Généré par scripts/mail-integrate.sh - ne pas éditer sur place.
# =============================================================================
services:
  nginx-mailcow:
    networks:
      - mailcow-network
      - proxy
    # Traefik publie déjà 80/443 : on retire les ports de mailcow.
    ports: !reset []
    labels:
      traefik.enable: "true"
      traefik.docker.network: "@@PROXY_NETWORK@@"

      # Interface d'administration : mail.<domaine>
      traefik.http.routers.mailcow.rule: "Host(`@@MAILCOW_HOSTNAME@@`)"
      traefik.http.routers.mailcow.entrypoints: "websecure"
      traefik.http.routers.mailcow.tls.certResolver: "letsencrypt"
      traefik.http.routers.mailcow.middlewares: "secure-headers@file"
      traefik.http.routers.mailcow.service: "mailcow"
      traefik.http.services.mailcow.loadbalancer.server.port: "@@MAILCOW_HTTPS_PORT@@"
      traefik.http.services.mailcow.loadbalancer.server.scheme: "https"
      traefik.http.services.mailcow.loadbalancer.serversTransport: "mailcow@file"

      # Webmail : redirection vers SOGo
      traefik.http.routers.mailcow-webmail.rule: "Host(`webmail.@@DOMAIN@@`) || Host(`mails.@@DOMAIN@@`)"
      traefik.http.routers.mailcow-webmail.entrypoints: "websecure"
      traefik.http.routers.mailcow-webmail.tls.certResolver: "letsencrypt"
      traefik.http.routers.mailcow-webmail.middlewares: "mailcow-webmail,secure-headers@file"
      traefik.http.routers.mailcow-webmail.service: "mailcow"
      traefik.http.middlewares.mailcow-webmail.redirectRegex.regex: "^https://(webmail|mails)[.]@@DOMAIN_REGEX@@/.*$"
      traefik.http.middlewares.mailcow-webmail.redirectRegex.replacement: "https://@@MAILCOW_HOSTNAME@@/SOGo/"
      traefik.http.middlewares.mailcow-webmail.redirectRegex.permanent: "false"

      # Webmail direct : SOGo sans passer par l'UI mailcow ni son SSO.
      traefik.http.routers.mailcow-sogo.rule: "Host(`sogo.@@DOMAIN@@`)"
      traefik.http.routers.mailcow-sogo.entrypoints: "websecure"
      traefik.http.routers.mailcow-sogo.tls.certResolver: "letsencrypt"
      traefik.http.routers.mailcow-sogo.middlewares: "sogo-root-redirect,secure-headers@file"
      traefik.http.routers.mailcow-sogo.service: "mailcow"
      traefik.http.middlewares.sogo-root-redirect.redirectRegex.regex: "^https://sogo[.]@@DOMAIN_REGEX@@/$"
      traefik.http.middlewares.sogo-root-redirect.redirectRegex.replacement: "https://sogo.@@DOMAIN@@/SOGo/"
      traefik.http.middlewares.sogo-root-redirect.redirectRegex.permanent: "false"

networks:
  proxy:
    external: true
    name: "@@PROXY_NETWORK@@"
